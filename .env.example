# Innoweb Jarvis settings. Copy to .env and fill in what you have.

# Port, and who can open it. 0.0.0.0 lets the TV open it over the office Wi-Fi.
PORT=5210
HOST=0.0.0.0

# Password for /edit from other devices (phone). Without it, only this PC can edit.
JARVIS_PASSWORD=

# Lead finder database (read-only).
LEADFINDER_DB=C:/Users/rafam/Agency/lead_finder/data/app/app.db

# FlowDesk. The URL and anon key are read from FlowDesk's own .env.
# Add EITHER the service role key (Supabase > Project settings > API keys)
# OR the login of a FlowDesk admin.
FLOWDESK_SERVICE_ROLE_KEY=
FLOWDESK_EMAIL=
FLOWDESK_PASSWORD=

# Innolink (Supabase project wjmrwszorppurykmwmwt > Project settings > API keys > service_role).
INNOLINK_SERVICE_ROLE_KEY=


# Jarvis's speaking voice (a Windows voice name).
JARVIS_VOICE=Microsoft David Desktop

# Jarvis answers open questions through Claude Code (your Claude subscription).
# Found automatically; set this only if it is installed somewhere unusual.
CLAUDE_BIN=
